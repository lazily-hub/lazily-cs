<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Lazily.R3</PackageId>
    <Version>0.9.0</Version>
    <Authors>lazily-hub</Authors>
    <Description>Optional R3 adapters for Lazily state graphs.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/lazily-hub/lazily-cs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/lazily-hub/lazily-cs</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lazily/Lazily.csproj"
                      Condition="'$(LazilyCoreCompatibilityProject)' == ''" />
    <ProjectReference Include="$(LazilyCoreCompatibilityProject)"
                      Condition="'$(LazilyCoreCompatibilityProject)' != ''" />
    <PackageReference Include="R3" Version="1.3.1" />
    <None Include="../../docs/r3-adapter.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../api/r3-api-v1.json" Pack="true" PackagePath="compatibility/" />
    <None Include="../../api/r3-core-compatibility-v1.json" Pack="true" PackagePath="compatibility/" />
  </ItemGroup>
</Project>
